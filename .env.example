# ── Paths ────────────────────────────────────────────────────────
CONFIG_ROOT=/volume1/docker/config
DATA_ROOT=/volume1/data

# ── Permissions (run: id your-username) ─────────────────────────
PUID=1000
PGID=10

# ── Timezone ─────────────────────────────────────────────────────
TZ=Asia/Bahrain

# ── Pi-hole ──────────────────────────────────────────────────────
PIHOLE_PASSWORD=changeme

# ── Tailscale ────────────────────────────────────────────────────
# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a reusable auth key so container survives reboots
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare Tunnel ────────────────────────────────────────────
# Get token from: https://one.dash.cloudflare.com → Networks → Tunnels → Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# ── Plex ─────────────────────────────────────────────────────────
# Get token at https://plex.tv/claim (expires in 4 min, grab right before docker compose up)
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx
